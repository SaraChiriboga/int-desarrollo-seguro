# Copiar a .env (NO subir .env a Git). El secret lo entrega Persona 2 por canal privado.
PORT=3000
BASE_URL=http://localhost:3000
KEYCLOAK_ISSUER=http://localhost:8080/realms/SecureDev-Realm
OIDC_CLIENT_ID=sistema-a-client
OIDC_CLIENT_SECRET=PEGAR_AQUI_EL_SECRET_DEL_TAB_CREDENTIALS
SESSION_SECRET=GENERAR_CON__node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rol requerido para /admin (rol de realm en Keycloak)
ADMIN_ROLE=sistema-a-admin
NODE_ENV=development
